@@ -0,0 +1,217 @@
+/-
+Copyright (c) 2026 MathEconLib contributors. All rights reserved.
+Released under Apache 2.0 license as described in the file LICENSE.
+Authors: MathEconLib contributors
+-/
+module
+
+public import MathEconLib.Matching.Classical.Marriage.OrderIdeals
+public import MathEconLib.ForMathlib.Order.ThinChains
+
+/-!
+# Two chain partitions of intrinsic stable-matching irreducibles
+
+Each join-irreducible is labelled by one man and one woman, using its
+coordinate threshold generator. Equal-man and equal-woman fibres are chains.
+-/
+
+@[expose] public section
+
+namespace MathEconLib.Matching
+
+universe u v
+
+namespace MarriageMarket
+
+variable {M : Type u} {W : Type v} (mkt : MarriageMarket M W)
+variable [Fintype M] [Fintype W]
+
+namespace StableMatching
+
+/-- A join-irreducible cannot be generated by an unmatched coordinate. -/
+theorem thresholdIndex_isSome
+    (j : {μ : mkt.StableMatching // SupIrred μ}) :
+    (thresholdIndex mkt j).2.isSome := by
+  let m := (thresholdIndex mkt j).1
+  have hgen := thresholdIndex_generator mkt j
+  change thresholdGenerator mkt m (j.1.matching m) = j.1 at hgen
+  cases hj : j.1.matching m with
+  | some w =>
+      change (j.1.matching m).isSome
+      simp [hj]
+  | none =>
+      have hbotnone : (⊥ : mkt.StableMatching).matching m = none :=
+        (mkt.eq_none_iff_of_stable j.1.isStable (⊥ : mkt.StableMatching).isStable m).mp hj
+      have hbot : MeetsThreshold mkt m none (⊥ : mkt.StableMatching) := by
+        let := mkt.prefM m
+        change none ≤ (⊥ : mkt.StableMatching).matching m
+        rw [hbotnone]
+      have hle : thresholdGenerator mkt m none ≤ (⊥ : mkt.StableMatching) :=
+        thresholdGenerator_le mkt hbot
+      have heq : thresholdGenerator mkt m none = (⊥ : mkt.StableMatching) :=
+        le_antisymm hle bot_le
+      have hjbot : j.1 = (⊥ : mkt.StableMatching) := by
+        rw [hj] at hgen
+        exact hgen.symm.trans heq
+      exact False.elim (j.2.ne_bot hjbot)
+
+/-- The chosen generating coordinate, with the outside option removed. -/
+noncomputable def irreducibleLabel
+    (j : {μ : mkt.StableMatching // SupIrred μ}) : M × W :=
+  let p := thresholdIndex mkt j
+  (p.1, p.2.get (thresholdIndex_isSome mkt j))
+
+theorem irreducibleLabel_eq_thresholdIndex
+    (j : {μ : mkt.StableMatching // SupIrred μ}) :
+    thresholdIndex mkt j =
+      ((irreducibleLabel mkt j).1, some (irreducibleLabel mkt j).2) := by
+  apply Prod.ext
+  · rfl
+  · exact (Option.coe_get (thresholdIndex_isSome mkt j)).symm
+
+theorem irreducibleLabel_matching
+    (j : {μ : mkt.StableMatching // SupIrred μ}) :
+    j.1.matching (irreducibleLabel mkt j).1 =
+      some (irreducibleLabel mkt j).2 := by
+  have h := irreducibleLabel_eq_thresholdIndex mkt j
+  exact congrArg Prod.snd h
+
+theorem irreducibleLabel_generator
+    (j : {μ : mkt.StableMatching // SupIrred μ}) :
+    thresholdGenerator mkt (irreducibleLabel mkt j).1
+      (some (irreducibleLabel mkt j).2) = j.1 := by
+  have h := thresholdIndex_generator mkt j
+  rw [irreducibleLabel_eq_thresholdIndex mkt j] at h
+  exact h
+
+theorem irreducibleLabel_injective :
+    Function.Injective (irreducibleLabel mkt) := by
+  intro j k h
+  apply thresholdIndex_injective mkt
+  rw [irreducibleLabel_eq_thresholdIndex mkt j,
+    irreducibleLabel_eq_thresholdIndex mkt k, h]
+
+/-- The join-irreducibles carrying a fixed man label form a chain. -/
+theorem same_man_comparable
+    (j k : {μ : mkt.StableMatching // SupIrred μ})
+    (hman : (irreducibleLabel mkt j).1 = (irreducibleLabel mkt k).1) :
+    j.1 ≤ k.1 ∨ k.1 ≤ j.1 := by
+  let m := (irreducibleLabel mkt j).1
+  let := mkt.prefM m
+  rcases le_total (some (irreducibleLabel mkt j).2)
+      (some (irreducibleLabel mkt k).2) with h | h
+  · left
+    rw [← irreducibleLabel_generator mkt j]
+    apply thresholdGenerator_le mkt
+    change mkt.leM m (some (irreducibleLabel mkt j).2) (k.1.matching m)
+    have hk := irreducibleLabel_matching mkt k
+    rw [← hman] at hk
+    have h' : mkt.leM m (some (irreducibleLabel mkt j).2)
+        (some (irreducibleLabel mkt k).2) := h
+    rw [hk]
+    exact h'
+  · right
+    rw [← irreducibleLabel_generator mkt k]
+    apply thresholdGenerator_le mkt
+    change mkt.leM (irreducibleLabel mkt k).1
+      (some (irreducibleLabel mkt k).2)
+      (j.1.matching (irreducibleLabel mkt k).1)
+    have hj := irreducibleLabel_matching mkt j
+    rw [hman] at hj
+    have h' : mkt.leM m (some (irreducibleLabel mkt k).2)
+        (some (irreducibleLabel mkt j).2) := h
+    have hman' : m = (irreducibleLabel mkt k).1 := hman
+    rw [← hman'] at hj ⊢
+    rw [hj]
+    exact h'
+
+private theorem le_of_same_woman_preference
+    (j k : {μ : mkt.StableMatching // SupIrred μ})
+    (hw : (irreducibleLabel mkt j).2 = (irreducibleLabel mkt k).2)
+    (hp : mkt.leW (irreducibleLabel mkt j).2
+      (some (irreducibleLabel mkt k).1)
+      (some (irreducibleLabel mkt j).1)) :
+    j.1 ≤ k.1 := by
+  let m := (irreducibleLabel mkt j).1
+  let m' := (irreducibleLabel mkt k).1
+  let w := (irreducibleLabel mkt j).2
+  by_cases hmm : m = m'
+  · have hlabel : irreducibleLabel mkt j = irreducibleLabel mkt k :=
+      Prod.ext hmm hw
+    exact le_of_eq (congrArg Subtype.val (irreducibleLabel_injective mkt hlabel))
+  have hwstrict : mkt.ltW w (some m') (some m) := by
+    let := mkt.prefW w
+    apply lt_of_le_of_ne hp
+    intro heq
+    exact hmm (Option.some.inj heq).symm
+  have hkw : k.1.matching.symm w = some m' := by
+    have hk := irreducibleLabel_matching mkt k
+    rw [← hw] at hk
+    exact k.1.matching.eq_some_iff.mpr hk
+  have hkm : mkt.leM m (some w) (k.1.matching m) := by
+    let := mkt.prefM m
+    apply le_of_not_gt
+    intro hlt
+    have hblock : mkt.IsBlockingPair k.1.matching m w := by
+      refine ⟨hlt, ?_⟩
+      change mkt.ltW w (k.1.matching.symm w) (some m)
+      rw [hkw]
+      exact hwstrict
+    exact k.1.isStable.2.1 m w hblock
+  rw [← irreducibleLabel_generator mkt j]
+  exact thresholdGenerator_le mkt hkm
+
+/-- The join-irreducibles carrying a fixed woman label form a chain. -/
+theorem same_woman_comparable
+    (j k : {μ : mkt.StableMatching // SupIrred μ})
+    (hw : (irreducibleLabel mkt j).2 = (irreducibleLabel mkt k).2) :
+    j.1 ≤ k.1 ∨ k.1 ≤ j.1 := by
+  let w := (irreducibleLabel mkt j).2
+  let := mkt.prefW w
+  rcases le_total (some (irreducibleLabel mkt k).1)
+      (some (irreducibleLabel mkt j).1) with h | h
+  · left
+    exact le_of_same_woman_preference mkt j k hw h
+  · right
+    have h' : mkt.leW (irreducibleLabel mkt k).2
+        (some (irreducibleLabel mkt j).1)
+        (some (irreducibleLabel mkt k).1) := by
+      rw [← hw]
+      exact h
+    exact le_of_same_woman_preference mkt k j hw.symm h'
+
+/-- Sharper cardinal bound: a join-irreducible has a distinct man-woman label. -/
+theorem card_supIrred_le_pairs :
+    Nat.card {μ : mkt.StableMatching // SupIrred μ} ≤
+      Fintype.card M * Fintype.card W := by
+  classical
+  let : Fintype mkt.StableMatching := by
+    have hinj : Function.Injective
+        (fun μ : mkt.StableMatching => fun m : M => μ.matching m) := by
+      intro μ ν h
+      apply ext mkt
+      apply PEquiv.ext
+      intro m
+      exact congrFun h m
+    have : Finite mkt.StableMatching := Finite.of_injective _ hinj
+    exact Fintype.ofFinite _
+  have hcard : Fintype.card {μ : mkt.StableMatching // SupIrred μ} ≤
+      Fintype.card (M × W) :=
+    Fintype.card_le_of_injective (irreducibleLabel mkt)
+      (irreducibleLabel_injective mkt)
+  simpa only [Nat.card_eq_fintype_card, Fintype.card_prod] using hcard
+
+/-- The intrinsic irreducibles form a thin double chain poset, with men as
+rows and women as columns. -/
+noncomputable def irreducibleThinChains :
+    MathEconLib.Order.ThinChains
+      {μ : mkt.StableMatching // SupIrred μ} M W where
+  row := fun j => (irreducibleLabel mkt j).1
+  col := fun j => (irreducibleLabel mkt j).2
+  label_injective := irreducibleLabel_injective mkt
+  row_comparable := fun j k h => same_man_comparable mkt j k h
+  col_comparable := fun j k h => same_woman_comparable mkt j k h
+
+end StableMatching
+end MarriageMarket
+end MathEconLib.Matching
